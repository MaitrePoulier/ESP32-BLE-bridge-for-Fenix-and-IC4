# ESP32-WROOM-32E-N8R2 : 8 MB flash, 2 MB PSRAM
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM (was -DBOARD_HAS_PSRAM -mfix-esp32-psram-cache-issue)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_CACHE_WORKAROUND=y

# Same runtime as Arduino-ESP32: 240 MHz, 1 kHz tick, main loop on core 1
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Serial console (esp_console): commands sorted in 'help'
CONFIG_CONSOLE_SORTED_HELP=y

# LVGL (replaces lib/Config/lv_conf.h : only these differ from the defaults)
# Use the system heap (internal RAM + PSRAM) instead of a fixed 64 kB pool
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_BUILD_DEMOS=y
CONFIG_LV_USE_DEMO_WIDGETS=y
CONFIG_LV_USE_DEMO_BENCHMARK=y
CONFIG_LV_DEMO_BENCHMARK_ALIGNED_FONTS=y

# Diagnostic screen fonts
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# IC4 Bridge: BLE only (NimBLE), central + peripheral roles
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
# IC4 + HRM 600 (centrals) + 3 clients (Fenix, IC4 console, nRF Connect)
CONFIG_BTDM_CTRL_BLE_MAX_CONN=5
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=5
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="IC4 Bridge"
CONFIG_BT_NIMBLE_SVC_GAP_APPEARANCE=0x0484
# NimBLE host memory in PSRAM: the internal SRAM stays for LVGL and the WiFi
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# Task watchdog: restarts the board if the LVGL loop or an idle task stops for 10 s
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
